# Copiá este archivo a .env y completá la clave. .env está en .gitignore y NUNCA se sube.

# Clave de Gemini (capa gratuita en https://aistudio.google.com/apikey). Se usa para el LLM y los embeddings.
GOOGLE_API_KEY=tu-clave-de-gemini

# Modelos por rol (opcional). En la capa gratuita cada modelo tiene su propia cuota
# (5 pedidos por minuto y ~20 por día): si uno se agota, cambialo por otro (ej. gemini-3.6-flash).
# SUPERVISOR_MODEL=gemini-3-flash-preview   # supervisor y sintetizador
# LLM_MODEL=gemini-3.5-flash-lite           # investigador y analista
# LLM_THINKING_LEVEL=low
# LLM_RPM=5                                 # ritmo máximo por modelo; 0 = sin límite (clave paga)
# LLM_MAX_OUTPUT_TOKENS=8192
# EMBEDDING_MODEL=gemini-embedding-001

# Base vectorial (opcional)
# KNOWLEDGE_DIR=./knowledge
# CHROMA_PERSIST_DIR=./vectorstore
# CHROMA_COLLECTION=orbital_docs
# TOP_K=4

# Límites del orquestador (opcional)
# MAX_STEPS=8
# MAX_ATTEMPTS_PER_AGENT=2
# AGENT_RECURSION_LIMIT=12
# GRAPH_RECURSION_LIMIT=40
